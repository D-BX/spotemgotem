{
  "name": "spotemgotem",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "electron:dev": "node electron/dev.cjs",
    "electron:preview": "pnpm build && electron .",
    "electron:pack": "pnpm build && electron-builder"
  },
  "build": {
    "appId": "com.spotemgotem.app",
    "productName": "spotemgotem",
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "afterPack": "electron/afterPack.cjs",
    "electronDownload": {
      "version": "33.4.11+wvcus",
      "mirror": "https://github.com/castlabs/electron-releases/releases/download/v",
      "customDir": "33.4.11+wvcus"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.music"
    }
  },
  "dependencies": {
    "@solidjs/router": "^0.15.3",
    "@tanstack/solid-virtual": "^3.11.2",
    "fflate": "^0.8.3",
    "idb-keyval": "^6.2.1",
    "solid-js": "^1.9.3"
  },
  "devDependencies": {
    "@types/spotify-web-playback-sdk": "^0.1.19",
    "electron": "https://github.com/castlabs/electron-releases#v33.4.11+wvcus",
    "electron-builder": "^25.1.8",
    "typescript": "^5.7.2",
    "vite": "^6.0.3",
    "vite-plugin-solid": "^2.11.0",
    "vitest": "^5.0.4"
  }
}
